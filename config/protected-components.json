{
  "version": 1,
  "components": [
    {
      "id": "administrator-users-roles-directory",
      "description": "Canonical school-scoped Users & Roles directory with one-time credential reissue controls.",
      "route": "/users",
      "files": [
        {
          "path": "public/users-and-roles.html",
          "requiredMarkers": [
            "<h1>Users &amp; Roles</h1>",
            "This directory is read-only;",
            "id=\"directory-rows\"",
            "fetch('/api/users'",
            "data-reissue=",
            "Temporary credentials issued"
          ]
        },
        {
          "path": "src/user-directory.js",
          "requiredMarkers": [
            "export const USER_DIRECTORY_SQL",
            "WHERE u.school_id = ?",
            "assertCanonicalSchoolContext",
            "export function createUserDirectoryService"
          ]
        },
        {
          "path": "src/server.mjs",
          "requiredMarkers": [
            "pathname === '/api/users'",
            "'/users': '/users-and-roles.html'",
            "credentials/reissue",
            "CREDENTIALS_REISSUED"
          ]
        },
        {
          "path": "test/users-and-roles.test.js",
          "requiredMarkers": [
            "Users & Roles API authorizes server-side",
            "directory service rejects accounts outside the canonical school",
            "never returns credentials",
            "never returns credentials"
          ]
        },
        {
          "path": "src/durable-credential-management.js",
          "requiredMarkers": [
            "createDurableCredentialManagement",
            "temporaryPassword",
            "auth_sessions"
          ]
        }
      ]
    },
    {
      "id": "student-attendance-register",
      "description": "Protected attendance register API, authoritative enrollment roster, isolated sample fixtures, responsive controls, and versioned durable writes.",
      "route": "/attendance/students",
      "files": [
        {
          "path": "public/attendance.html",
          "requiredMarkers": [
            "id=\"attendance-register\"",
            "id=\"attendance-mobile-cards\"",
            "id=\"save-attendance\"",
            "id=\"attendance-sample-mode\"",
            "id=\"attendance-date\""
          ]
        },
        {
          "path": "public/attendance-register.js",
          "requiredMarkers": [
            "/api/attendance/register",
            "/api/attendance/students/sync",
            "attendance-mobile-cards",
            "requestAttendanceJson",
            "attendanceData",
            "function isReadOnly",
            "changedEntries.push",
            "Changing register mode will discard unsaved attendance marks"
          ]
        },
        {
          "path": "src/server.mjs",
          "requiredMarkers": [
            "attendanceRegister.resolvePeriod",
            "attendanceRegister.enrolledStudents",
            "attendanceRegister.saveSampleAttendance",
            "ATTENDANCE_CORRECTION_FORBIDDEN",
            "success: false, data: null"
          ]
        },
        {
          "path": "src/attendance-register-service.js",
          "requiredMarkers": [
            "schoolInformation",
            "FROM student_enrollments e",
            "e.academic_year_id=? AND e.term_id=?",
            "fixtureType: 'attendance'"
          ]
        },
        {
          "path": "src/attendance-repository.js",
          "requiredMarkers": [
            "async function saveStudentAttendanceBatch",
            "adapter.transaction",
            "ATTENDANCE_VERSION_REQUIRED",
            "ATTENDANCE_TRANSACTION_UNAVAILABLE"
          ]
        },
        {
          "path": "schema/034_attendance_academic_scope.sql",
          "requiredMarkers": [
            "uq_student_attendance_scope_identity",
            "attendance_date, class_id, student_id, subject_key"
          ]
        },
        {
          "path": "test/attendance-register-reliability.test.js",
          "requiredMarkers": [
            "HTML, blank bodies, malformed JSON",
            "HTTP Sample / Test saves use isolated fixtures",
            "attendance endpoints preserve 401/403",
            "genuine empty enrollment set",
            "attendance batch corrections require attendance.correct"
          ]
        },
        {
          "path": "test/attendance-repository-integrity.test.js",
          "requiredMarkers": [
            "transaction-backed",
            "rolls back an earlier row",
            "exact current version",
            "cannot guarantee transactions"
          ]
        },
        {
          "path": "public/styles.css",
          "requiredMarkers": [
            "@media(max-width:1023px)",
            "max-width:1220px",
            "@media(min-width:1024px)"
          ]
        },
        {
          "path": ".github/workflows/protected-components.yml",
          "requiredMarkers": [
            "test/attendance-*.test.js",
            "Attendance integrity regression suite"
          ]
        },
        {
          "path": "docs/attendance-register-integrity.md",
          "requiredMarkers": [
            "Attendance API contract",
            "Migration and recovery procedure",
            "Release checklist"
          ]
        }
      ]
    },
    {
      "id": "student-result-slip-cascade",
      "description": "Automatic academic-year, term, class, and eligible-student result-slip cascade with stale-request protection.",
      "route": "/results",
      "files": [
        {
          "path": "public/results.html",
          "requiredMarkers": [
            "name=\"academicYear\"",
            "name=\"studentId\"",
            "name=\"sampleMode\""
          ]
        },
        {
          "path": "public/result-view.js",
          "requiredMarkers": [
            "studentLoadVersion",
            "/api/academic/result-students",
            "No students found for the selected class and academic context.",
            "Students:"
          ]
        },
        {
          "path": "test/part1-mobile-attendance-result-slip.test.js",
          "requiredMarkers": [
            "automatic result slip",
            "stale"
          ]
        }
      ]
    }
  ]
}
