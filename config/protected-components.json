          ]
        },
        {
          "path": "src/durable-credential-management.js",
          "requiredMarkers": [
            "createDurableCredentialManagement",
            "temporaryPassword",
            "auth_sessions"
          ]
        }
      ]
    },
    {
      "id": "student-attendance-register",
      "description": "Canonical attendance register with desktop preservation, mobile cards, sample isolation, and versioned persistence.",
      "route": "/attendance/students",
      "files": [
        {
          "path": "public/attendance.html",
          "requiredMarkers": [
            "id=\"attendance-register\"",
            "id=\"attendance-mobile-cards\"",
            "id=\"save-attendance\""
          ]
        },
        {
          "path": "public/attendance-register.js",
          "requiredMarkers": [
            "/api/attendance/register",
            "/api/attendance/students/sync",
            "attendance-mobile-cards",
            "version"
          ]
        },
        {
          "path": "src/server.mjs",
          "requiredMarkers": [
            "existingAttendance",
            "attendanceRepository.listStudentRecords",
            "const save = (entry)"
          ]
