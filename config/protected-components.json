          "requiredMarkers": [
            "id=\"attendance-register\"",
            "id=\"attendance-mobile-cards\"",
            "id=\"save-attendance\"",
            "id=\"attendance-sample-mode\"",
            "id=\"attendance-date\""
          ]
        },
        {
          "path": "public/attendance-register.js",
          "requiredMarkers": [
            "/api/attendance/register",
            "/api/attendance/students/sync",
            "attendance-mobile-cards",
            "requestAttendanceJson",
            "attendanceData",
            "function isReadOnly",
            "changedEntries.push",
            "Changing register mode will discard unsaved attendance marks"
