{
  "version": 1,
  "components": [
    {
      "id": "administrator-users-roles-directory",
      "description": "Canonical school-scoped Users & Roles directory with one-time credential reissue controls.",
      "route": "/users",
      "files": [
        {
          "path": "public/users-and-roles.html",
          "requiredMarkers": [
            "<h1>Users &amp; Roles</h1>",
            "This directory is read-only;",
            "id=\"directory-rows\"",
            "fetch('/api/users'",
            "data-reissue=",
            "Temporary credentials issued"
          ]
        },
        {
          "path": "src/user-directory.js",
          "requiredMarkers": [
            "export const USER_DIRECTORY_SQL",
            "WHERE u.school_id = ?",
            "assertCanonicalSchoolContext",
            "export function createUserDirectoryService"
          ]
        },
        {
          "path": "src/server.mjs",
          "requiredMarkers": [
            "pathname === '/api/users'",
            "'/users': '/users-and-roles.html'",
            "credentials/reissue",
            "CREDENTIALS_REISSUED"
          ]
        },
        {
          "path": "test/users-and-roles.test.js",
          "requiredMarkers": [
