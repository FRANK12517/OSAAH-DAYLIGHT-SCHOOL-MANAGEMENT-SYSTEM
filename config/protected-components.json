          ]
        }
      ]
    },
    {
      "id": "student-result-slip-cascade",
      "description": "Automatic academic-year, term, class, and eligible-student result-slip cascade with stale-request protection.",
      "route": "/results",
      "files": [
        {
          "path": "public/results.html",
          "requiredMarkers": [
            "name=\"academicYear\"",
            "name=\"studentId\"",
            "name=\"sampleMode\""
          ]
        },
        {
          "path": "public/result-view.js",
          "requiredMarkers": [
            "studentLoadVersion",
