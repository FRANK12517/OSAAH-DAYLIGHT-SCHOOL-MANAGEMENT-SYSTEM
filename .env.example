OSAAH_AI_ENABLED=false
OSAAH_AI_PROVIDER_ID=openai
OSAAH_AI_MODEL_ID=
OSAAH_AI_API_KEY=
OSAAH_AI_PROVIDER_ENABLED=false
OSAAH_AI_PROVIDER_TIMEOUT_MS=30000
OSAAH_AI_PROVIDER_RETRY_LIMIT=1
OSAAH_AI_MAX_OUTPUT_TOKENS=1024
OSAAH_AI_MAX_TOOL_CALLS=6
OSAAH_AI_MAX_ROUNDS=3
OSAAH_AI_MAX_DURATION_MS=15000
OSAAH_AI_MAX_CONTEXT_CHARS=50000
OSAAH_AI_MAX_MESSAGE_CHARS=1000
OSAAH_AI_MAX_HISTORY_ITEMS=6
OSAAH_AI_MAX_HISTORY_CHARS=3000
OSAAH_AI_MAX_CONVERSATION_TURNS=20
OSAAH_AI_CONVERSATION_TIMEOUT_MS=16000
OSAAH_AI_ACTION_INTEGRITY_KEY=replace-with-a-server-managed-random-key
# The application runtime accepts TiDB only. Set this explicitly in production.
OSAAH_DATABASE_ADAPTER=tidb
# TiDB Cloud URL must select osaahdaylightschool; keep server-side only.
DATABASE_URL=
# Legacy PostgreSQL settings are rejected by the application runtime.
OSAAH_POSTGRES_URL=
# Legacy provider-specific CA variables are not used by TiDB.
SUPABASE_CA_CERT=
DB_SSL_CA=
OSAAH_PG_SSL_CA=
OSAAH_SESSION_SECRET=replace-with-at-least-32-random-characters
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
ARKESEL_CALLBACK_TOKEN=
ARKESEL_COST_PER_SEGMENT_GHS=
OSAAH_SMS_PREVIEW_SECRET=
PUBLIC_BASE_URL=
