  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "bcrypt": "^6.0.0",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "image-size": "^2.0.2",
    "playwright": "^1.64.0"
  }
