{
  "name": "osaah-daylight-school-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 foundation for OsaaH Daylight School Management System",
  "type": "module",
  "scripts": {
    "assets:verify": "node scripts/verify-login-assets.mjs",
    "start": "node src/server.mjs",
    "test": "node --test",
    "test:fee-hub": "node --test test/fee-hub-regression.test.js test/fee-setup-part4.test.js test/fee-collections-repository.test.js test/parent-fee-obligations-repository.test.js test/receive-payment-fee-types-consistency.test.js",
    "test:staff-attendance": "node --test test/staff-attendance-*.test.js test/staff-leave-reconciliation-part3.test.js",
    "migration:status": "node scripts/migrate.mjs status",
    "supabase:schema:validate": "node scripts/validate-supabase-migration.mjs",
    "supabase:migration:validate": "node scripts/supabase-migrate.mjs validate",
    "supabase:migration:status": "node scripts/supabase-migrate.mjs status",
    "supabase:migration:apply": "node scripts/supabase-migrate.mjs apply",
    "database:mysql-inventory": "node scripts/inventory-mysql-dependencies.mjs",
    "database:reconcile-snapshots": "node scripts/reconcile-postgres-snapshots.mjs",
    "test:supabase": "node --test test/postgres-database-adapter.test.js test/postgres-pglite-application.test.js test/supabase-migrate-cli.test.js test/supabase-existing-reconcile-pglite.test.js",
    "test:postgres:integration": "node scripts/run-postgres-integration.mjs",
