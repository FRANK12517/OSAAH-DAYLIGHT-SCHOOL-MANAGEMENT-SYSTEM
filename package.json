    "admissions:migration-preflight": "node scripts/admission-workflow-migration-preflight.mjs",
    "test:admission-protection": "node scripts/admission-protection.mjs --run-tests --validate-migrations",
    "migration:baseline": "node scripts/record-production-baseline.mjs",
    "migration:forward-reconciliation": "node scripts/production-forward-reconciliation.mjs",
    "protection:verify": "node scripts/verify-protected-components.mjs"
